# env file
.env

# IntelliJ IDEA
.idea/

# 런타임 데이터·산출물 (로컬 전용)
/main
.DS_Store
/settings.json
/dependent/
/downloads/
/output/

# 로컬 Windows 테스트 VM (dockurr/windows) 설정과 디스크
/win10/
/compose.yml

# Rust / Node / Worker 빌드 산출물
target/
node_modules/
.wrangler/
dist/

# Claude Code 로컬 상태
.claude/settings.local.json
.claude/worktrees/

# Tauri 앱 (app/)
app/dist/
app/src-tauri/gen/
app/src-tauri/permissions/autogenerated/

# Worker(worker/) 산출물·생성물. worker-env.d.ts는 pnpm check(wrangler types)가 매번 만든다(머리줄의 32자리 hex 해시가
# public-scan에 걸린다, worker.md §13.1). 기본 이름 worker-configuration.d.ts는 만들지 않는다(있으면 wrangler dev가
# 실제 비밀값 파일을 연다, worker.md 구현 중 변경 9. worker-config.mjs가 있으면 실패한다)
worker/node_modules/
worker/dist/
worker/.wrangler/
worker/worker-env.d.ts
worker/worker-configuration.d.ts

# Worker 로컬 비밀값(1Password Environment 마운트). 예시 파일만 커밋한다
.dev.vars
.dev.vars.*
!.dev.vars.example
