{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main 창 기본 권한: core:default와 앱 command만. 플러그인(dialog·opener·notification·clipboard-manager)은 Rust command 안에서만 부르므로 JS에 플러그인 권한을 주지 않는다.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-naver-cookies",
    "allow-clear-naver-cookies",
    "allow-import-legacy",
    "allow-pick-folder",
    "allow-resolve",
    "allow-check-output",
    "allow-enqueue",
    "allow-list-jobs",
    "allow-subscribe-jobs",
    "allow-pause-job",
    "allow-resume-job",
    "allow-remove-job",
    "allow-clear-finished",
    "allow-open-output",
    "allow-reveal-output",
    "allow-quit",
    "allow-auth-status",
    "allow-clipboard-link"
  ]
}
