{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VOD 클립 다운로더",
  "version": "0.6.1",
  "identifier": "io.github.chnu-kim.chzzk-downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VOD 클립 다운로더",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#F3F3F3",
        "zoomHotkeysEnabled": false,
        "scrollBarStyle": "fluentOverlay",
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ko-KR"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMkFFQTI5MTY1NTM0NDgKUldSSU5GVVdLZW9xbkZ0R253cmUvSkd6ZmpSTzY0RkM1dmhRRFZxejU2TXVBOVRSeHpnd2k4RGoK"
    }
  }
}
