  "rules": [
    {
      "id": "DC1",
      "pattern": "클릭",
      "note": "A-COPY P1, content.md §3.1"
    },
    {
      "id": "DC1",
      "pattern": "(?<![가-힣])우리",
      "note": "content.md §3.1-6"
    },
    {
      "id": "DC1",
      "pattern": "시겠어요|시나요",
      "note": "D44"
    },
    {
      "id": "DC1",
      "pattern": "되어요",
      "note": "D44, content.md §3.1-5"
    },
    {
      "id": "DC1",
      "pattern": "기 바랍니다",
      "note": "D44"
    },
    {
      "id": "DC1",
      "pattern": "잠시 (?:뒤에|후)",
      "note": "content.md §3.1-7"
    },
    {
      "id": "DC1",
      "pattern": "(?<![가-힣])후(?:에|엔)?(?![가-힣])",
      "note": "content.md §3.1-7"
    },
    {
      "id": "DC2",
      "pattern": "[가-힣]니다(?![가-힣])",
      "note": "D44 합쇼체"
    },
    {
      "id": "DC2",
      "pattern": "시오(?![가-힣])",
      "note": "D44 합쇼체"
    },
    {
      "id": "DC2",
      "pattern": "(?<!마)(?<![가-힣] 주)세요",
      "note": "D44 요청은 해 주세요 하나"
    },
    {
      "id": "DC3",
      "pattern": "\\{\\w+\\}[’”]?(?:이|가|을|를|은|는|과|와|으?로|의|이?에요|예요)",
      "note": "D46"
    },
    {
      "id": "DC3",
      "pattern": "[을를이가은는]\\([을를이가은는]\\)",
      "note": "D46 이중 표기"
    },
    {
      "id": "DC4",
      "pattern": "\\d+(?:\\.\\d+)?\\s?(?:MB/s|KB|MB|GB|%|초|분)",
      "note": "D47·D48·D50"
    },
    {
      "id": "DC5",
      "pattern": "\\.\\.\\.",
