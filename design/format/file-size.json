    {"name": "1000 진법 1023", "args": [1023, 1000], "out": "1.02KB"},
    {"name": "1000 진법 1024", "args": [1024, 1000], "out": "1.02KB"},
    {"name": "1024 진법 1023B", "args": [1023, 1024], "out": "1023B"},
    {"name": "1024 진법 1024는 1.00KB", "args": [1024, 1024], "out": "1.00KB"},
    {"name": "소수 1자리 구간", "args": [22900, 1000], "out": "22.9KB"},
