    {"name": "9.995KB는 3자리를 지켜 10.0KB", "args": [9995, 1000], "out": "10.0KB"},
    {"name": "99.95KB는 100KB", "args": [99950, 1000], "out": "100KB"},
    {"name": "TB 근처 올림", "args": [2999999999999, 1000], "out": "3.00TB"},
