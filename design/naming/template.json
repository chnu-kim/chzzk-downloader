    {"template": "{date}_{channel}_{title}", "linux": [
      {"kind": "video", "name": "261018_채널이름_저녁 방송.mp4"},
      {"kind": "clip", "name": "채널이름_웃긴 장면.mp4"},
      {"kind": "live", "name": "261018_채널이름_오늘 방송.mp4"}
    ]},
    {"template": "{title} [{no}]", "linux": [
      {"kind": "video", "name": "저녁 방송 [12345].mp4"},
      {"kind": "clip", "name": "웃긴 장면 [abcDEF123].mp4"},
      {"kind": "live", "name": "오늘 방송 [].mp4"}
    ]},
    {"template": "{foo}", "error": {"kind": "unknownToken", "token": "foo"}}
  ]
