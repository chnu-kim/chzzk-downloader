{
  "$comment": "저장소 설정의 선언(docs/design/cicd.md §7, §4.4 설정 drift, 구현 중 변경 74). nightly ruleset-drift가 repo-settings.mjs --check로 GitHub API의 실제 값과 비교하고 다르면 ci-loop:ruleset-drift 이슈를 연다. --apply(기본은 계획만, --yes로 씀)가 이 선언을 선언 순서대로 적용한다. 키마다 endpoint의 응답에서 선언한 필드만 보고(응답에 필드가 없으면 불일치), 배열은 집합으로 비교하며, pick은 id가 섞인 배열 원소를 선언한 키만 남겨 비교한다. ruleset은 .github/rulesets/*.json이 선언하고 실제 ruleset 이름 집합과 같아야 한다. 환경 셋(release·audit·drift)은 배포 정책 목록을 {name,type} 집합으로, protection_rules를 {type,wait_timer}로 본다: 정책이 하나 더 생기거나(* 등) wait timer·reviewer가 생기거나 관리자 우회가 켜지면 불일치다. release의 wait timer는 두지 않는다(0): 타이머는 환경의 모든 작업(verify의 자동 되돌리기, rollback.yml)을 늦추고, 태그를 만들 수 있는 사람은 tags ruleset이 관리자로 한정한다(구현 중 변경 74).",
  "settings": {
    "actions_permissions": {
      "endpoint": "repos/{repo}/actions/permissions",
      "expect": {
        "enabled": true,
        "allowed_actions": "selected",
        "sha_pinning_required": true
      },
      "apply": {
        "method": "PUT"
      }
    },
    "actions_selected": {
      "endpoint": "repos/{repo}/actions/permissions/selected-actions",
      "expect": {
        "github_owned_allowed": true,
        "verified_allowed": false,
        "patterns_allowed": [
          "Swatinem/rust-cache@*",
          "pnpm/action-setup@*",
          "taiki-e/install-action@*"
        ]
      },
      "apply": {
        "method": "PUT"
      }
    },
    "actions_workflow_permissions": {
      "endpoint": "repos/{repo}/actions/permissions/workflow",
      "expect": {
        "default_workflow_permissions": "read",
        "can_approve_pull_request_reviews": false
      },
      "apply": {
        "method": "PUT"
      }
    },
    "fork_pr_contributor_approval": {
      "endpoint": "repos/{repo}/actions/permissions/fork-pr-contributor-approval",
      "expect": {
        "approval_policy": "all_external_contributors"
      },
      "apply": {
        "method": "PUT"
      }
    },
    "repository": {
      "endpoint": "repos/{repo}",
      "expect": {
        "visibility": "public",
        "default_branch": "master",
        "security_and_analysis": {
          "secret_scanning": {
            "status": "enabled"
          },
          "secret_scanning_push_protection": {
            "status": "enabled"
          }
        }
      },
      "apply": {
        "method": "PATCH",
        "body": {
          "security_and_analysis": {
            "secret_scanning": {
              "status": "enabled"
            },
            "secret_scanning_push_protection": {
              "status": "enabled"
            }
          }
        }
      }
    },
    "environment_release": {
      "endpoint": "repos/{repo}/environments/release",
      "pick": {
        "protection_rules": [
          "type",
          "wait_timer"
        ]
      },
      "expect": {
        "name": "release",
        "can_admins_bypass": false,
        "deployment_branch_policy": {
          "protected_branches": false,
          "custom_branch_policies": true
        },
        "protection_rules": [
          {
            "type": "branch_policy"
          }
        ]
      },
      "apply": {
        "method": "PUT",
        "body": {
          "wait_timer": 0,
          "reviewers": null,
          "can_admins_bypass": false,
          "deployment_branch_policy": {
            "protected_branches": false,
            "custom_branch_policies": true
          }
        }
      }
    },
    "environment_release_policies": {
      "endpoint": "repos/{repo}/environments/release/deployment-branch-policies?per_page=100",
      "pick": {
        "branch_policies": [
          "name",
          "type"
        ]
      },
      "expect": {
        "branch_policies": [
          {
            "name": "master",
            "type": "branch"
          },
          {
            "name": "v*",
            "type": "tag"
          }
        ]
      },
      "apply": {
        "kind": "set",
        "key": "branch_policies",
        "endpoint": "repos/{repo}/environments/release/deployment-branch-policies"
      }
    },
    "environment_audit": {
      "endpoint": "repos/{repo}/environments/audit",
      "pick": {
        "protection_rules": [
          "type",
          "wait_timer"
        ]
      },
      "expect": {
        "name": "audit",
        "can_admins_bypass": false,
        "deployment_branch_policy": {
          "protected_branches": false,
          "custom_branch_policies": true
        },
        "protection_rules": [
          {
            "type": "branch_policy"
          }
        ]
      },
      "apply": {
        "method": "PUT",
        "body": {
          "wait_timer": 0,
          "reviewers": null,
          "can_admins_bypass": false,
          "deployment_branch_policy": {
            "protected_branches": false,
            "custom_branch_policies": true
          }
        }
      }
    },
    "environment_audit_policies": {
      "endpoint": "repos/{repo}/environments/audit/deployment-branch-policies?per_page=100",
      "pick": {
        "branch_policies": [
          "name",
          "type"
        ]
      },
      "expect": {
        "branch_policies": [
          {
            "name": "master",
            "type": "branch"
          }
        ]
      },
      "apply": {
        "kind": "set",
        "key": "branch_policies",
        "endpoint": "repos/{repo}/environments/audit/deployment-branch-policies"
      }
    },
    "environment_drift": {
      "endpoint": "repos/{repo}/environments/drift",
      "pick": {
        "protection_rules": [
          "type",
          "wait_timer"
        ]
      },
      "expect": {
        "name": "drift",
        "can_admins_bypass": false,
        "deployment_branch_policy": {
          "protected_branches": false,
          "custom_branch_policies": true
        },
        "protection_rules": [
          {
            "type": "branch_policy"
          }
        ]
      },
      "apply": {
        "method": "PUT",
        "body": {
          "wait_timer": 0,
          "reviewers": null,
          "can_admins_bypass": false,
          "deployment_branch_policy": {
            "protected_branches": false,
            "custom_branch_policies": true
          }
        }
      }
    },
    "environment_drift_policies": {
      "endpoint": "repos/{repo}/environments/drift/deployment-branch-policies?per_page=100",
      "pick": {
        "branch_policies": [
          "name",
          "type"
        ]
      },
      "expect": {
        "branch_policies": [
          {
            "name": "master",
            "type": "branch"
          }
        ]
      },
      "apply": {
        "kind": "set",
        "key": "branch_policies",
        "endpoint": "repos/{repo}/environments/drift/deployment-branch-policies"
      }
    }
  }
}
