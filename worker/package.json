{
  "name": "chzzk-downloader-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "check": "wrangler types worker-env.d.ts --config wrangler.jsonc --include-runtime=false --env-file .dev.vars.example && tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist --metafile",
    "dev": "wrangler dev --config wrangler.jsonc --port 8787 --env-file .dev.vars.example",
    "e2e": "node scripts/e2e-dev.mjs",
    "dev:real": "wrangler dev --config wrangler.jsonc --port 8787 --env-file .dev.vars --var PUBLIC_ORIGIN:http://localhost:8787"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
