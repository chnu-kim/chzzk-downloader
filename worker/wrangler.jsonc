// Cloudflare Worker 설정(docs/design/worker.md §3·§10·§13). 불변식은 scripts/ci/worker-config.mjs가 검사한다:
//   - account_id·routes·route·zone_id·custom_domain·env·migrations를 두지 않는다(계정 id는 배포 env CLOUDFLARE_ACCOUNT_ID).
//   - DO는 exports 형식만. 클래스 AuthStore·바인딩 AUTH는 첫 배포 뒤 바꾸지 않는다.
//   - vars에는 운영 기본값(공개 값) 두 개만 둔다. PUBLIC_ORIGIN·BUILD_ID는 배포 --var, 비밀값은 wrangler secret put.
//   - invocation 로그를 끈다(요청 URL에 OAuth code·state가 실린다, §14).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chzzk-downloader",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "exports": {
    "AuthStore": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH", "class_name": "AuthStore" }]
  },
  "r2_buckets": [{ "binding": "DIST", "bucket_name": "chzzk-downloader-dist" }],
  "vars": {
    "CHZZK_AUTHORIZE_URL": "https://chzzk.naver.com/account-interlock",
    "CHZZK_API_BASE": "https://openapi.chzzk.naver.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
